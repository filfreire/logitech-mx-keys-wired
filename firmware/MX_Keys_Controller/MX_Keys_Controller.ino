// Logitech MX Keys laptop-style keyboard controller on a Teensy 4.1 / FPC daughterboard.
// Based on Frank Adams' Dell_1545_Keyboard_4p1 example, with the key matrix, modifier
// matrix and pin lists generated by matrixgenerator.py (option 4 = Teensy 4.1) from the
// MX_Keys.txt key/pin recording made with Matrix_Decoder_4p1.
//
// This routine uses the Teensyduino "Micro-Manager Method" to send Normal and Modifier
// keys over USB. Multi-media keys are sent with keyboard press and release functions.
// Description of Teensyduino keyboard functions is at www.pjrc.com/teensy/td_keyboard.html
//
// NOTE: the top row follows the MX Keys legends. F1-F2, F8-F12, volume-up and calculator send
// media (consumer) codes from the consumer[] matrix; F3-F5, screenshot, menu and lock send
// OS-specific shortcuts from the shortcut[] matrix. Holding Fn (or Fn-lock) sends the plain
// key from normal[] instead. KEY_F13..KEY_F15 stay on the Easy-Switch (computer 1/2/3) keys
// for binding in software, since a wired keyboard has no hosts to switch.
//
#define MODIFIERKEY_FN 0x8f   // give Fn key a HID code
#define CAPS_LED 13 // Teensy LED shows Caps-Lock
//
// Key indicator LEDs on the FPC (found with tools/LED_Probe). Common anode on FPC 26, one
// cathode per LED; an LED is lit by pulling its cathode low. FPC n = Teensy n for these pins.
#define IND_ANODE 26 // common anode for all four indicators
#define IND_COMP1 27 // computer 1 (Easy-Switch) key LED
#define IND_COMP2 28 // computer 2 key LED
#define IND_COMP3 29 // computer 3 key LED
#define IND_CAPS  30 // Caps Lock key LED
//
// Debounce (eager, per-key): a press or release is sent the instant it is first seen, then
// that key is "locked out" for this many scans (~1ms each) so contact bounce during the
// settle window is ignored. This gives ~1ms response and never drops a fast or glancing tap
// (a deferred debounce that waits for N stable scans can swallow very short taps). Raise it
// if a worn switch chatters; lower it toward 2 for a tighter lockout.
#define DEBOUNCE 4
//
// OS mode (Fn+P = Windows, Fn+O = Mac). Mac mode remaps the modifiers to the MX Keys Mac
// legends: Start key -> Option, left Alt -> Cmd, right Alt -> right Cmd.
#define OS_WIN 0
#define OS_MAC 1
#define FLASH_MS 1000 // how long an indicator LED flashes to confirm a mode change
//
// Settings saved in the Teensy EEPROM. EE_MAGIC holds SETTINGS_MAGIC once settings have been
// written; anything else (a fresh Teensy) means use the defaults. Change SETTINGS_MAGIC if
// the layout below changes.
#include <EEPROM.h>
#define SETTINGS_MAGIC 0xA5
#define EE_MAGIC   0
#define EE_FN_LOCK 1
#define EE_OS_MODE 2
#define EE_BACKLIGHT 3
//
// Backlight: PWM on pin 33 drives a low-side MOSFET on the ~27V LED string (see README).
// F6/F7 step the level down/up; level 0 is off. bl_duty[] maps each level through a 2.2
// gamma curve so every step looks like the same change in brightness.
#define BACKLIGHT_PIN 33
#define BL_PWM_HZ     20000 // above audible range, no visible flicker
#define BL_LEVELS     8     // brightness steps above off
#define BL_DEFAULT    4     // level on a fresh Teensy
#define BL_RAMP_STEP  32    // duty change per loop (~1ms), so a step fades in ~0.1s
#define BL_DOWN 1           // backlight_key[] values
#define BL_UP   2
const int bl_duty[BL_LEVELS + 1] = {0, 42, 194, 473, 891, 1456, 2175, 3053, 4095}; // 12-bit
//
// Build at 24 MHz (FQBN option speed=24, see README). Scanning needs very little CPU, and the
// default 600 MHz just makes the chip run warm. At 24 MHz the 20kHz PWM has ~1200 steps, so
// analogWrite() scales the 12-bit duty down to about 10 bits; still smooth for the fade.
#if F_CPU > 24000000
#warning "Built above 24 MHz: add speed=24 to the FQBN to keep the Teensy cool"
#endif
//
// Consumer page usages the Teensyduino key names don't cover (sent the same way as KEY_MEDIA_*)
#define KEY_MEDIA_BRIGHTNESS_INC (0x6F | 0xE400)  // screen brightness up
#define KEY_MEDIA_BRIGHTNESS_DEC (0x70 | 0xE400)  // screen brightness down
#define KEY_MEDIA_CALCULATOR     (0x192 | 0xE400) // AL Calculator
//
