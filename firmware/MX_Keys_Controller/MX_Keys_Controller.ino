// Per-key lockout counters. Global, so zero-initialized at reset. After a key's state change
// is accepted, this is set to DEBOUNCE and counts down one per scan; while non-zero the key
// is ignored, which absorbs contact bounce without dropping the change itself.
byte debounce[rows_max][cols_max];
//
// What each key sent when it was pressed (0 = nothing held). The release undoes exactly
// that, so changing Fn while a key is held can't leave a key stuck down on the host.
int sent[rows_max][cols_max];
boolean sent_sc[rows_max][cols_max]; // true while a key holds a shortcut's modifiers down
//
// Define the Teensy 4.1 I/O numbers (translated from the FPC pin #)
//
// Rows are the driven (output) pins - FPC 17..25
int Row_IO[rows_max] = {15,8,14,9,10,11,12,24,25};
//
// Columns are the read (input) pins with pullups - FPC 1..16
int Col_IO[cols_max] = {23,0,22,1,21,2,20,3,19,4,18,5,17,6,16,7};


// Declare variables that will be used by functions
boolean slots_full = LOW; // Goes high when slots 1 thru 6 contain normal keys
// slot 1 thru slot 6 hold the normal key values to be sent over USB.
int slot1 = 0; //value of 0 means the slot is empty and can be used.
int slot2 = 0;
int slot3 = 0;
int slot4 = 0;
int slot5 = 0;
int slot6 = 0;
//
int mod_shift_l = 0; // These variables are sent over USB as modifier keys.
int mod_shift_r = 0; // Each is either set to 0 or MODIFIER_ ...
int mod_ctrl_l = 0;
int mod_ctrl_r = 0;
int mod_alt_l = 0;
int mod_alt_r = 0;
int mod_gui = 0;
int mod_gui_r = 0; // right GUI (right Cmd in Mac mode)
int mod_shortcut = 0; // modifiers held by a shortcut key (see shortcuts[])
//
boolean Fn_pressed = HIGH; // Initialize Fn key to HIGH = "not pressed"
boolean fn_lock = false;   // toggled by Fn+Esc. Off: consumer keys send media by default.
                           // On: they send their normal F-key by default. Fn flips either.
byte os_mode = OS_WIN;     // set by Fn+P (Windows) / Fn+O (Mac)
byte bl_level = BL_DEFAULT; // backlight level, 0 (off) .. BL_LEVELS
int bl_now = 0;            // backlight PWM duty currently output, ramps toward bl_duty[bl_level]
int flash_pin = 0;         // indicator LED currently flashing (0 = none)
unsigned long flash_start; // millis() when that flash started
//
// Function to load the key name into the first available slot
void load_slot(int key) {
  if (!slot1)  {
    slot1 = key;
  }
  else if (!slot2) {
    slot2 = key;
  }
  else if (!slot3) {
    slot3 = key;
  }
  else if (!slot4) {
    slot4 = key;
  }
  else if (!slot5) {
    slot5 = key;
  }
  else if (!slot6) {
    slot6 = key;
  }
  if (!slot1 || !slot2 || !slot3 || !slot4 || !slot5 || !slot6)  {
    slots_full = LOW; // slots are not full
  }
  else {
    slots_full = HIGH; // slots are full
  }
}
//
// Function to clear the slot that contains the key name
void clear_slot(int key) {
  if (slot1 == key) {
    slot1 = 0;
  }
  else if (slot2 == key) {
    slot2 = 0;
  }
  else if (slot3 == key) {
    slot3 = 0;
  }
  else if (slot4 == key) {
    slot4 = 0;
  }
  else if (slot5 == key) {
    slot5 = 0;
  }
  else if (slot6 == key) {
    slot6 = 0;
  }
  if (!slot1 || !slot2 || !slot3 || !slot4 || !slot5 || !slot6)  {
    slots_full = LOW; // slots are not full
  }
  else {
    slots_full = HIGH; // slots are full
  }
}
//
// Function to load the modifier key name into the appropriate mod variable
void load_mod(int m_key) {
  if (m_key == MODIFIERKEY_LEFT_SHIFT)  {
    mod_shift_l = m_key;
  }
  else if (m_key == MODIFIERKEY_RIGHT_SHIFT)  {
    mod_shift_r = m_key;
  }
  else if (m_key == MODIFIERKEY_LEFT_CTRL)  {
    mod_ctrl_l = m_key;
  }
  else if (m_key == MODIFIERKEY_RIGHT_CTRL)  {
    mod_ctrl_r = m_key;
  }
  else if (m_key == MODIFIERKEY_LEFT_ALT)  {
    mod_alt_l = m_key;
  }
  else if (m_key == MODIFIERKEY_RIGHT_ALT)  {
    mod_alt_r = m_key;
  }
  else if (m_key == MODIFIERKEY_GUI)  {
    mod_gui = m_key;
  }
  else if (m_key == MODIFIERKEY_RIGHT_GUI)  {
    mod_gui_r = m_key;
  }
}
//
// Function to load 0 into the appropriate mod variable
void clear_mod(int m_key) {
  if (m_key == MODIFIERKEY_LEFT_SHIFT)  {
    mod_shift_l = 0;
  }
  else if (m_key == MODIFIERKEY_RIGHT_SHIFT)  {
    mod_shift_r = 0;
  }
  else if (m_key == MODIFIERKEY_LEFT_CTRL)  {
    mod_ctrl_l = 0;
  }
  else if (m_key == MODIFIERKEY_RIGHT_CTRL)  {
    mod_ctrl_r = 0;
  }
  else if (m_key == MODIFIERKEY_LEFT_ALT)  {
    mod_alt_l = 0;
  }
  else if (m_key == MODIFIERKEY_RIGHT_ALT)  {
    mod_alt_r = 0;
  }
  else if (m_key == MODIFIERKEY_GUI)  {
    mod_gui = 0;
  }
  else if (m_key == MODIFIERKEY_RIGHT_GUI)  {
    mod_gui_r = 0;
  }
}
//
// Function to translate a modifier for the current OS mode
int os_mod(int m_key) {
  if (os_mode == OS_MAC) {
    if (m_key == MODIFIERKEY_GUI)       return MODIFIERKEY_LEFT_ALT;  // Start key -> Option
    if (m_key == MODIFIERKEY_LEFT_ALT)  return MODIFIERKEY_GUI;       // Alt -> Cmd
    if (m_key == MODIFIERKEY_RIGHT_ALT) return MODIFIERKEY_RIGHT_GUI; // Alt Gr -> right Cmd
  }
  return m_key;
}
//
// Function to send the modifier keys over usb
void send_mod() {
  Keyboard.set_modifier(mod_shift_l | mod_shift_r | mod_ctrl_l | mod_ctrl_r | mod_alt_l | mod_alt_r | mod_gui | mod_gui_r | mod_shortcut);
  Keyboard.send_now();
}
//
// Function to send the normal keys in the 6 slots over usb
void send_normals() {
  Keyboard.set_key1(slot1);
  Keyboard.set_key2(slot2);
  Keyboard.set_key3(slot3);
  Keyboard.set_key4(slot4);
  Keyboard.set_key5(slot5);
  Keyboard.set_key6(slot6);
  Keyboard.send_now();
}
//
// Function to press a shortcut for the current OS mode: modifiers first, then the key, as
// two reports so the host sees the modifiers already down. Returns the key it loaded into a
// slot (0 if modifiers only) so the release can clear exactly that.
int press_shortcut(byte sc) {
  int m_key = (os_mode == OS_MAC) ? shortcuts[sc].mac_mod : shortcuts[sc].win_mod;
  int key = (os_mode == OS_MAC) ? shortcuts[sc].mac_key : shortcuts[sc].win_key;
  mod_shortcut = m_key;
  send_mod();
  if (key) {
    load_slot(key);
    send_normals();
  }
  return key;
}
//
// Function to release a shortcut: the key first, then the modifiers
void release_shortcut(int key) {
  if (key) {
    clear_slot(key);
    send_normals();
  }
  mod_shortcut = 0;
  send_mod();
}
//
// Function to set a pin to high impedance (acts like open drain output)
void go_z(int pin)
{
  pinMode(pin, INPUT);
  digitalWrite(pin, HIGH);
}
//
// Function to set a pin as an input with a pullup
void go_pu(int pin)
{
  pinMode(pin, INPUT_PULLUP);
  digitalWrite(pin, HIGH);
}
//
// Function to send a pin to a logic low
void go_0(int pin)
{
  pinMode(pin, OUTPUT);
  digitalWrite(pin, LOW);
}
//
// Function to send a pin to a logic high
void go_1(int pin)
{
  pinMode(pin, OUTPUT);
  digitalWrite(pin, HIGH);
}
//
// Function to make an indicator LED pin a weak output. There are no series resistors on the
// indicator LEDs, so the pad drive strength is dropped to DSE=1 (~150 ohm output impedance)
// on both the anode and cathode pins, which limits each LED to a few mA.
void ind_pin(int pin, int level)
{
  pinMode(pin, OUTPUT);
  *portControlRegister(pin) = IOMUXC_PAD_DSE(1);
  digitalWrite(pin, level);
}
//
// Function to turn an indicator LED on or off (cathode low = on, high = off)
void set_ind(int pin, boolean on)
{
  digitalWrite(pin, on ? LOW : HIGH);
}
//
// Function to light an indicator LED briefly; loop() turns it off after FLASH_MS
void flash_ind(int pin)
{
  if (flash_pin) {
    set_ind(flash_pin, false); // cut short any flash already running
  }
  flash_pin = pin;
  flash_start = millis();
  set_ind(pin, true);
}
//
// Function to load the saved settings, or keep the defaults on a fresh Teensy
void load_settings()
{
  if (EEPROM.read(EE_MAGIC) == SETTINGS_MAGIC) {
    fn_lock = EEPROM.read(EE_FN_LOCK) != 0;
    os_mode = (EEPROM.read(EE_OS_MODE) == OS_MAC) ? OS_MAC : OS_WIN;
    byte level = EEPROM.read(EE_BACKLIGHT); // unwritten (0xFF) on boards saved before this
    bl_level = (level <= BL_LEVELS) ? level : BL_DEFAULT;
  }
}
//
// Function to save the settings. EEPROM.update only writes bytes that changed, and this is
// only called when a setting changes, so flash wear is not a concern.
void save_settings()
{
  EEPROM.update(EE_FN_LOCK, fn_lock);
  EEPROM.update(EE_OS_MODE, os_mode);
  EEPROM.update(EE_BACKLIGHT, bl_level);
  EEPROM.update(EE_MAGIC, SETTINGS_MAGIC);
}
//
// Function to step the backlight level up or down and save it. loop() fades to the new level.
void step_backlight(byte dir)
{
  if ((dir == BL_UP) && (bl_level < BL_LEVELS)) {
    bl_level++;
  }
  else if ((dir == BL_DOWN) && (bl_level > 0)) {
    bl_level--;
  }
  save_settings();
}
//
// Function to switch OS mode, confirm it on an indicator LED (computer 1 = Windows,
// computer 2 = Mac) and save it
void set_os_mode(byte mode)
{
  os_mode = mode;
  flash_ind(mode == OS_MAC ? IND_COMP2 : IND_COMP1);
  save_settings();
}
//
//----------------------------------Setup-------------------------------------------
void setup() {
  load_settings();
//
  analogWriteResolution(12);                     // 0..4095, matches bl_duty[]
  analogWriteFrequency(BACKLIGHT_PIN, BL_PWM_HZ);
  analogWrite(BACKLIGHT_PIN, 0);                 // start dark; loop() fades up to bl_level
//
  ind_pin(IND_ANODE, HIGH); // power the common anode
  ind_pin(IND_COMP1, HIGH); // all indicators start off
  ind_pin(IND_COMP2, HIGH);
  ind_pin(IND_COMP3, HIGH);
  ind_pin(IND_CAPS, HIGH);
//
  for (int a = 0; a < cols_max; a++) {  // loop thru all column pins
    go_pu(Col_IO[a]); // set each column pin as an input with a pullup
  }
//
  for (int b = 0; b < rows_max; b++) {  // loop thru all row pins
    go_z(Row_IO[b]); // set each row pin as a floating output
  }
}
//
extern volatile uint8_t keyboard_leds; // 8 bits sent from host to Teensy that give keyboard LED status. Caps lock is bit D1.
//
//---------------------------------Main Loop---------------------------------------------
//
void loop() {
// Scan keyboard matrix with an outer loop that drives each row low and an inner loop that reads every column (with pull ups).
// The routine looks at each key's present state (by reading the column input pin) and also the previous state from the last scan
// that was 30msec ago. The status of a key that was just pressed or just released is sent over USB and the state is saved in the old_key matrix.
// The keyboard keys will read as logic low if they are pressed (negative logic).
// The old_key matrix also uses negative logic (low=pressed).
//
  for (int x = 0; x < rows_max; x++) {   // loop thru the rows
    go_0(Row_IO[x]); // Activate Row (send it low)
    delayMicroseconds(10); // give the row time to go low and settle out
    for (int y = 0; y < cols_max; y++) {   // loop thru the columns
      if (debounce[x][y]) {                 // key is in its lockout window after a recent change
        debounce[x][y]--;                   // count the window down and ignore this key for now
      }
      else {                                // not locked out, so any change here is real - act now
        int reading = digitalRead(Col_IO[y]); // LOW (0) = pressed, HIGH (1) = released (negative logic)
        if (reading != old_key[x][y]) {      // the key changed state
          boolean pressed = (reading == LOW); // true = this change is a press, false = a release
// **********Modifier keys including the Fn special case
          if (modifier[x][y] != 0) {
            if (pressed) {
              if (modifier[x][y] != MODIFIERKEY_FN) { // Exclude Fn modifier key
                sent[x][y] = os_mod(modifier[x][y]); // the modifier this OS mode sends
                load_mod(sent[x][y]); // load the pressed modifier into its mod_... variable
                send_mod();           // send all modifier states over USB
              }
              else {
                Fn_pressed = LOW; // Fn status variable is active low
              }
            }
            else { // released
              if (modifier[x][y] != MODIFIERKEY_FN) {
                clear_mod(sent[x][y]); // clear what the press sent, even if OS mode changed
                sent[x][y] = 0;
                send_mod();            // send all modifier states over USB
              }
              else {
                Fn_pressed = HIGH; // Fn is no longer active
              }
            }
            old_key[x][y] = reading;      // commit the new state
            debounce[x][y] = DEBOUNCE;    // start the lockout window
          }
// ***********Consumer keys, shortcut keys, normal keys and media keys
          else if ((normal[x][y] != 0) || (media[x][y] != 0) || (consumer[x][y] != 0) ||
                   (shortcut[x][y] != 0) || (backlight_key[x][y] != 0)) {
            if (pressed) {
              boolean accepted = true;
              boolean use_media = (!Fn_pressed != fn_lock); // Fn held XOR Fn-lock
              if (!Fn_pressed && (normal[x][y] == KEY_ESC)) {
                fn_lock = !fn_lock; // Fn+Esc toggles Fn-lock; the Esc itself is not sent
                save_settings();
              }
              else if (!Fn_pressed && (normal[x][y] == KEY_P)) {
                set_os_mode(OS_WIN); // Fn+P = Windows; the P is not sent
              }
              else if (!Fn_pressed && (normal[x][y] == KEY_O)) {
                set_os_mode(OS_MAC); // Fn+O = Mac; the O is not sent
              }
              else if ((backlight_key[x][y] != 0) && (use_media || (normal[x][y] == 0))) {
                step_backlight(backlight_key[x][y]); // handled here, nothing sent to the host
              }
              else if ((consumer[x][y] != 0) && (use_media || (normal[x][y] == 0))) {
                // consumer key: sent unless Fn/Fn-lock picks the F-key, or always if there
                // is no F-key alternative.
                // Uses the media-key interface, so it does not need one of the 6 slots.
                Keyboard.press(consumer[x][y]);
                sent[x][y] = consumer[x][y];
              }
              else if ((shortcut[x][y] != 0) && (use_media || (normal[x][y] == 0))) {
                // shortcut key: same default/Fn rule as consumer keys, but it needs a free
                // slot for its key, so it retries like a normal key when the slots are full
                if (!slots_full) {
                  sent[x][y] = press_shortcut(shortcut[x][y]);
                  sent_sc[x][y] = true;
                }
                else {
                  accepted = false;
                }
              }
              else if (!Fn_pressed && (media[x][y] != 0)) { // Fn pressed -> tap the media key
                Keyboard.press(media[x][y]);
                delay(5); // hold briefly so the press is seen before the release
                Keyboard.release(media[x][y]);
              }
              else if ((normal[x][y] != 0) && !slots_full) { // normal key into a free slot
                load_slot(normal[x][y]);
                send_normals();
                sent[x][y] = normal[x][y];
              }
              else {
                // slots full: do not commit or lock out, so this press retries on the next
                // scan once one of the 6 slots frees up
                accepted = false;
              }
              if (accepted) {
                old_key[x][y] = reading;   // commit the press
                debounce[x][y] = DEBOUNCE; // start the lockout window
              }
            }
            else { // released - undo whatever the press sent
              if (sent_sc[x][y]) { // a shortcut: its key (if any) and its modifiers
                release_shortcut(sent[x][y]);
                sent_sc[x][y] = false;
              }
              else if (sent[x][y] == consumer[x][y] && sent[x][y] != 0) {
                Keyboard.release(sent[x][y]);
              }
              else if (sent[x][y] != 0) { // a normal key occupying a slot
                clear_slot(sent[x][y]);
                send_normals();
              }
              sent[x][y] = 0;
              old_key[x][y] = reading;   // commit the release
              debounce[x][y] = DEBOUNCE; // start the lockout window
            }
          }
          else {
            old_key[x][y] = reading;   // no key mapped at this cell; just track the state
            debounce[x][y] = DEBOUNCE;
          }
        }
      }
    }
    go_z(Row_IO[x]); // De-activate Row (send it to hi-z)
  }
//
// **********keyboard scan complete
//
// Turn on the LED on the Teensy for Caps Lock based on bit 1 in the keyboard_leds variable controlled by the USB host computer
//
  if (keyboard_leds & 1<<1) {  // mask off all bits but D1 and test if set
    go_1(CAPS_LED); // turn on the LED
  }
  else {
    go_0(CAPS_LED); // turn off the LED
  }
  set_ind(IND_CAPS, keyboard_leds & 1<<1); // same state on the Caps Lock key LED
  set_ind(IND_COMP3, fn_lock);             // computer 3 key LED shows Fn-lock
//
  if (bl_now != bl_duty[bl_level]) { // fade the backlight toward its level
    int target = bl_duty[bl_level];
    if (bl_now < target) {
      bl_now = min(bl_now + BL_RAMP_STEP, target);
    }
    else {
      bl_now = max(bl_now - BL_RAMP_STEP, target);
    }
    analogWrite(BACKLIGHT_PIN, bl_now);
  }
//
  if (flash_pin && (millis() - flash_start >= FLASH_MS)) { // end a confirmation flash
    set_ind(flash_pin, false);
    flash_pin = 0;
  }
//
  delay(1); // Scan period ~1ms. Debounce is now handled per-key by the DEBOUNCE counter,
            // not by this delay, so we can scan fast. A confirmed key change takes about
            // DEBOUNCE scans (~4ms) to register, with no chatter.
}
